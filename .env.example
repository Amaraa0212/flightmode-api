APP_NAME=FlightMode
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flightmode
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- FlightMode -------------------------------------------------------------
ADMIN_EMAIL=admin@flightmode.mn
ADMIN_PASSWORD=ChangeMe123!

FLIGHTMODE_TIMEZONE=Asia/Ulaanbaatar
ONLINE_CHECKIN_EXCLUDED_ZONES=A
PNL_ROUTING=PQC=PQCKLXH,CXR=CXRLLVN
PNL_SENDER=.BJSAV8X

# Chinggis agent API (allocations of these agency ids are pushed to Chinggis)
CHINGGIS_AGENT_API_BASE_URL=
CHINGGIS_AGENT_API_KEY=
CHINGGIS_AGENT_API_TIMEOUT=15
CHINGGIS_AGENCY_IDS=

# DCS demo data (php artisan db:seed --class=DcsDemoSeeder) — station agent at UBN
DCS_DEMO_EMAIL=ops@ubn-airport.mn
DCS_DEMO_PASSWORD=DcsDemo2026!
# DemoUsersSeeder: <om|mr>.<admin|staff|station|gate|agency.admin|agency.agent>@demo.flightmode.mn
DEMO_USERS_PASSWORD=Demo2026!

# Live DCS updates (Laravel Reverb): set BROADCAST_CONNECTION=reverb above, then php artisan reverb:start
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8090
REVERB_SERVER_PORT=8090
REVERB_SCHEME=http

# QZ Tray (DCS counter printers). Defaults: storage/app/private/qz/{digital-certificate.txt,private-key.pem}
# QZ_CERTIFICATE_PATH=
# QZ_PRIVATE_KEY_PATH=

# Client IP behind a proxy (Vercel rewrites of admin / DCS, nginx). "*" trusts X-Forwarded-For from anyone —
# use it only when the API is not reachable directly, otherwise list the proxy IPs.
TRUSTED_PROXIES=
